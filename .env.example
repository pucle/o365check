# Sao chép thành .env (không commit). Chỉ placeholder.

# Bắt buộc
API_TOKEN=change-me
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Neon: ưu tiên connection string pooled (thường cổng 6543) cho ứng dụng.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/dbname?sslmode=require

# Local / Render
PORT=7860
TZ_NAME=Asia/Ho_Chi_Minh
APP_ENV=local
MODEL_NAME=buffalo_l
# Render Free (~512Mi RAM): MODEL_NAME=buffalo_s, SKIP_MODEL_WARMUP=1, FACE_MAX_CONCURRENCY=1
INSIGHTFACE_HOME=

# UI ở domain khác backend (Render HTTPS). Nhiều origin: phân tách bằng dấu phẩy.
CORS_ORIGINS=

# Client Python
SERVER_URL=http://127.0.0.1:7860

# Tùy chọn: giới hạn pool Neon/Render Free
# DB_POOL_MAX=4
# DB_CONNECT_TIMEOUT=10
